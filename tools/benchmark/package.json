{
	"name": "@coulis/benchmark",
	"version": "0.0.0",
	"private": "true",
	"description": "Benchmark suite for coulis",
	"keywords": [],
	"license": "MIT",
	"author": "Ayoub Adib <adbayb@gmail.com>",
	"type": "module",
	"exports": {
		"./browser": {
			"source": "./src/cases/browser.tsx",
			"default": "./dist/browser.js"
		}
	},
	"scripts": {
		"benchmark": "pnpm benchmark:browser && pnpm benchmark:server",
		"benchmark:browser": "quickbundle build --minification && playwright test ./src/cases/browser.spec.ts",
		"benchmark:server": "tsx ./src/cases/server.spec.ts"
	},
	"devDependencies": {
		"@emotion/css": "11.13.5",
		"@emotion/server": "11.11.0",
		"coulis": "workspace:*",
		"playwright": "1.61.1",
		"quickbundle": "3.0.0",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"styled-components": "6.4.3",
		"tinybench": "6.0.2",
		"tsx": "4.23.1",
		"typescript": "6.0.3"
	}
}
